# Hosting settings template. Put actual values in your host's private settings.
# npm start, npm run dev and npm run check:config load .env if present.
NODE_ENV=production
PUBLIC_ORIGIN=
DATABASE_URL=
HOST_PASSWORD=
# Production binds all interfaces by default. Use your host's supplied PORT.
HOST=0.0.0.0
PORT=4173

# For local use instead: NODE_ENV=development, no DATABASE_URL or PUBLIC_ORIGIN.
# Optional local data folder (must be outside the source tree):
# DATA_DIR=/absolute/private/path/open-circle
